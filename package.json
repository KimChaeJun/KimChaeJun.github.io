{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site && npm run studio:check && npm run studio:build",
    "preview": "vite preview",
    "studio:dev": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy",
    "build:site": "tsc -b && vite build",
    "studio:check": "tsc --noEmit -p studio/tsconfig.json && npm --prefix studio run schema:check",
    "studio:build": "npm --prefix studio run build -- ../dist/admin --yes",
    "test": "node --experimental-strip-types --test tests/editor.test.ts tests/media.test.ts"
  },
  "dependencies": {
    "@sanity/client": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
